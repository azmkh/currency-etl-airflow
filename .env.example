# Copy this file to ".env" (the real .env is git-ignored).
# Airflow turns AIRFLOW_CONN_<NAME> into a connection with id "<name>" (lower-case).
# The values must match the MongoDB credentials in docker-compose.override.yml.
AIRFLOW_CONN_MONGO_CURRENCY='{"conn_type": "mongo", "host": "mongodb", "port": 27017, "login": "admin", "password": "admin123", "schema": "currency_db", "extra": {"authSource": "admin"}}'
